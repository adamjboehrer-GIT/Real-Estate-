# Google API credentials — NEVER commit this
google_credentials.json
*credentials*.json
*service_account*.json

# Database — too large/sensitive for git
database/leads.db

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/

# Environment variables
.env
.env.local

# macOS
.DS_Store

# Data imports (raw CSVs may contain PII)
data/imports/*.csv

# Local debug screenshots (not for production)
website/screenshots/
.meta-pw-profile

# Listing photo masters pulled from the brokerage site. Redundant with the
# deployed website/<listing>/images/full/ set (same 1800x1200), so keep them
# local rather than committing ~20MB of binaries per listing.
Marketing/Listings/*/source-photos/

# Title-pull working files — contain owner names and street addresses
scripts/.tp_*
scripts/.tmp_lines.json
scripts/_batch_send_generated.js

# Per-homeowner CMA pages — named address + valuation, private links only.
# Never commit while this repo is public.
website/report/
